{
  "name": "tailor-shop-firestore-rules-tests",
  "private": true,
  "description": "Tests for ../firestore.rules, run against the Firestore emulator.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-tailor-shop \"vitest run\"",
    "test:watch": "firebase emulators:exec --only firestore --project demo-tailor-shop \"vitest\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.11.0",
    "vitest": "^3.2.4"
  }
}
